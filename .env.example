# ----- Core -----
# PostgreSQL is required (local and production).
# Local example (Docker / Homebrew / apt):
DATABASE_URL="postgresql://safely:safely@localhost:5432/safely"

# Hosted (Neon / Supabase / Railway / Vercel Postgres):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# REQUIRED in production — generate with: openssl rand -base64 48
AUTH_SECRET="dev-secret-change-me-in-production-please-32chars"

# Public site URL (production domain)
NEXT_PUBLIC_APP_URL="https://safelyceliac.com"

# Optional: Web Push (closed-tab). Without these, in-tab Notification API still works.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# Optional: Upstash Redis REST (rate limits across instances). Without these, in-memory limits.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Optional: Resend (password reset email). Without this, /forgot shows a local link in development.
# RESEND_API_KEY=""
# EMAIL_FROM="Lumen <noreply@safelyceliac.com>"

# Optional: Vercel Blob uploads. Without this, photos save under public/uploads (local).
# BLOB_READ_WRITE_TOKEN=""
