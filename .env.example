# ----- Core -----
# PostgreSQL is required (local and production).
# Local example (Docker / Homebrew / apt):
DATABASE_URL="postgresql://ycn:ycn@localhost:5432/ycn"

# Hosted (Neon / Supabase / Railway / Vercel Postgres):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# REQUIRED in production — generate with: openssl rand -base64 48
AUTH_SECRET="dev-secret-change-me-in-production-please-32chars"
