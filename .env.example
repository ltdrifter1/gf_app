# ----- Core -----
# PostgreSQL is required (local and production).
# Local example (Docker / Homebrew / apt):
DATABASE_URL="postgresql://safely:safely@localhost:5432/safely"

# Hosted (Neon / Supabase / Railway / Vercel Postgres):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# REQUIRED in production — generate with: openssl rand -base64 48
AUTH_SECRET="dev-secret-change-me-in-production-please-32chars"

# Public site URL (production domain)
NEXT_PUBLIC_APP_URL="https://safelyceliac.com"

# Optional: Web Push (closed-tab). Without these, in-tab Notification API still works.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
