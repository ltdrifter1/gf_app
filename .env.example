# ----- Core -----
# Local development uses SQLite for a zero-config setup.
# Production target is PostgreSQL / Supabase: swap the provider in prisma/schema.prisma
# and set DATABASE_URL to your Postgres connection string.
DATABASE_URL="file:./dev.db"

# Secret used to sign auth session JWTs. Any non-empty string works for local dev.
AUTH_SECRET="dev-secret-change-me-in-production-please-32chars"

# ----- Optional integrations (app runs without these via graceful mock fallbacks) -----

# OpenAI: if set, the AI Celiac Assistant uses real completions; otherwise a built-in
# rule-based assistant is used.
OPENAI_API_KEY=""

# Stripe: if set, premium checkout uses real Stripe; otherwise a simulated checkout is used.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Mapbox token (optional). Maps use keyless MapLibre + OpenStreetMap tiles by default.
NEXT_PUBLIC_MAPBOX_TOKEN=""
