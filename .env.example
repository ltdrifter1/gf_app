# ----- Core -----
# Local development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL / Supabase / Neon):
# 1. In prisma/schema.prisma set: provider = "postgresql"
# 2. Set DATABASE_URL to your Postgres connection string, e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# REQUIRED in production — generate with: openssl rand -base64 48
AUTH_SECRET="dev-secret-change-me-in-production-please-32chars"
