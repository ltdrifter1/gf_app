// Lumen — Your gluten-free companion. Find your people — and a little more light.
//
// Production database: PostgreSQL (Neon / Supabase / Railway / Vercel Postgres).
// Local: set DATABASE_URL to a Postgres URL (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  username           String   @unique
  passwordHash       String
  name               String
  role               String   @default("USER") // USER | ADMIN
  avatarUrl          String?
  bio                String?
  location           String?
  /// online | away | offline | need-check-in | dining-out | quiet-today | helping-new
  presence           String   @default("offline")
  lastSeen           DateTime @default(now())
  /// Existing accounts default complete; new signups set false until /app/onboarding
  onboardingComplete Boolean  @default(true)
  createdAt          DateTime @default(now())

  profile Profile?

  posts      Post[]
  comments   Comment[]
  likes      Like[]
  savedPosts SavedPost[]

  following Follow[] @relation("follower")
  followers Follow[] @relation("following")

  roomMemberships ChatRoomMember[]
  messages        Message[]
  typing          TypingIndicator[]

  restaurantReviews    RestaurantReview[]
  restaurantsSubmitted Restaurant[]       @relation("restaurantSubmitter")
  recipes              Recipe[]
  recipeRatings        RecipeRating[]
  savedRecipes         SavedRecipe[]

  moodEntries    MoodEntry[]
  journalEntries JournalEntry[]
  healthLogs     HealthLog[]
  notifications  Notification[]

  flagsRaised   FlaggedContent[] @relation("reporter")
  flagsResolved FlaggedContent[] @relation("resolver")

  buddyMatchesAsA BuddyMatch[] @relation("buddyA")
  buddyMatchesAsB BuddyMatch[] @relation("buddyB")

  gfCostEntries      GfCostEntry[]
  labelScans         LabelScan[]
  insightDismissals  InsightDismissal[]
  pushSubscriptions  PushSubscription[]
  passwordResets     PasswordReset[]
  scanMisses         ScanMissReport[]
  blocking           UserBlock[] @relation("blocker")
  blockedBy          UserBlock[] @relation("blocked")
  muting             UserMute[]  @relation("muter")
  mutedBy            UserMute[]  @relation("muted")

  topEightOwned        TopEightFriend[]     @relation("topEightOwner")
  topEightAppearances  TopEightFriend[]     @relation("topEightFriend")
  wallReceived         ProfileWallComment[] @relation("wallOwner")
  wallWritten          ProfileWallComment[] @relation("wallAuthor")
}

model Profile {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosis    String? // celiac | gluten-intolerance | supporter | unspecified
  /// Experience stage for tailored journal prompts & matching
  /// newly-diagnosed | intermediate | experienced | caregiver
  journeyStage String?
  dietaryNotes String?
  /// Comma-separated goals: dining,support,parents,newly-diagnosed,recipes
  goals        String?
  // MySpace-style blurbs
  mood         String?
  likeToMeet   String?
  interests    String?
  /// Opt-in to private pattern insights from mood / logs / journal
  insightsOptIn Boolean @default(false)
  /// Optional buddy to nudge after a glutening (user id) — never public
  panicBuddyId  String?
  /// Keep scan history past 90 days
  keepScanHistory Boolean @default(false)
  notifyDms       Boolean @default(true)
  notifyBuddy     Boolean @default(true)
  notifyCheckin   Boolean @default(true)
  notifyDining    Boolean @default(true)
  /// Quiet hours in local 0–23; null = off
  quietHoursStart Int?
  quietHoursEnd   Int?
  lastCheckinNudgeAt DateTime?

  /// Profile Studio — Y2K skins, wallpaper, module order, name flair
  /// lumen | classic-blue | pink-glitter | lime | midnight | sunflower | ocean
  themeId          String  @default("lumen")
  coverUrl         String?
  /// theme | solid | gradient | image
  backgroundType   String  @default("theme")
  backgroundColor  String?
  backgroundUrl    String?
  /// 0–80 overlay on image / cover
  overlayOpacity   Int     @default(35)
  /// string[] of module ids: pic, blurbs, blog, friends, recipes, dining, wall
  moduleOrder      Json?
  /// default | display | typewriter | comic | hand | groovy
  nameFlair        String  @default("default")
  /// brand | pink | lime | gold | ice | grape
  nameAccent       String  @default("brand")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category  String
  title     String
  content   String
  imageUrl  String?
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  comments Comment[]
  likes    Like[]
  savedBy  SavedPost[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model Like {
  id     String @id @default(cuid())
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model ChatRoom {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  isCommunity Boolean   @default(true)
  /// community | dm | city-tonight
  kind        String    @default("community")
  city        String?
  expiresAt   DateTime?
  /// DMs: null = message request awaiting accept; set = open thread. Default now() backfills existing DMs.
  dmAcceptedAt DateTime? @default(now())
  createdAt   DateTime  @default(now())

  members  ChatRoomMember[]
  messages Message[]
  typing   TypingIndicator[]

  @@index([kind, city])
}

model ChatRoomMember {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  content   String
  hidden    Boolean  @default(false)
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model TypingIndicator {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @default(now())

  @@unique([roomId, userId])
}

model Restaurant {
  id                     String    @id @default(cuid())
  name                   String
  description            String?
  address                String
  city                   String
  lat                    Float
  lng                    Float
  imageUrl               String?
  cuisine                String?
  priceLevel             Int       @default(2)
  dedicatedFryer         Boolean   @default(false)
  separatePrepArea       Boolean   @default(false)
  dedicatedKitchen       Boolean   @default(false)
  certified              Boolean   @default(false)
  glutenFreeMenu         Boolean   @default(false)
  celiacSafe             Boolean   @default(false)
  delivery               Boolean   @default(false)
  staffTrainingLevel     String    @default("basic")
  crossContaminationRisk Int       @default(50)
  communityConfidence    Int       @default(50)
  /// published | pending | hidden | disputed
  status                 String    @default("pending")
  lastReviewAt           DateTime?
  submittedById          String?
  submittedBy            User?     @relation("restaurantSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt              DateTime  @default(now())

  reviews RestaurantReview[]
}

model RestaurantReview {
  id                        String     @id @default(cuid())
  restaurantId              String
  userId                    String
  rating                    Int
  safetyRating              Int
  content                   String
  imageUrl                  String?
  /// Structured celiac safety checklist (observed on this visit)
  observedDedicatedKitchen  Boolean?
  observedDedicatedFryer    Boolean?
  observedSeparatePrep      Boolean?
  observedLabeledMenu       Boolean?
  observedStaffUnderstood   Boolean?
  crossContactIncident      Boolean    @default(false)
  evidenceUrl               String?
  restaurant                Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user                      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                 DateTime   @default(now())
}

model Recipe {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String
  imageUrl    String?
  prepTime    Int
  cookTime    Int
  servings    Int      @default(2)
  ingredients Json
  steps       Json
  calories    Int      @default(0)
  protein     Int      @default(0)
  carbs       Int      @default(0)
  fat         Int      @default(0)
  createdAt   DateTime @default(now())

  ratings RecipeRating[]
  savedBy SavedRecipe[]
}

model RecipeRating {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  rating    Int
  review    String?
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([recipeId, userId])
}

model SavedRecipe {
  id       String @id @default(cuid())
  recipeId String
  userId   String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
}

model HealthResource {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  pillar   String // mental | physical
  category String
  content  String
  body     String  @default("")
  type     String  @default("article") // article | exercise | tip
  toolKey  String? // optional interactive tool id
}

model MoodEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood           Int
  note           String?
  shareToProfile Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String?
  content   String
  mood      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// Private glutening / symptom / flare log — never public
model HealthLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // glutening | symptom | flare
  severity  Int // 1-5
  note      String?
  createdAt DateTime @default(now())
}

model FlaggedContent {
  id           String    @id @default(cuid())
  type         String
  refId        String
  reason       String
  status       String    @default("open") // open | resolved | dismissed
  /// hide | unpublish | disputed | dismiss
  action       String?
  reporterId   String
  reporter     User      @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedById String?
  resolvedBy   User?     @relation("resolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
}

/// In-app notifications (DMs, companion nudges, system)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // message | companion | system | dining
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Soft buddy pairing (journeyStage + optional city). Icebreaker lives in the DM.
model BuddyMatch {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("buddyA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("buddyB", fields: [userBId], references: [id], onDelete: Cascade)
  roomId    String
  /// mentoring | caregiver | same-city | similar-stage
  reason    String
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId, createdAt])
  @@index([userBId, createdAt])
}

/// Canadian GF vs regular price tracker — private; user files their own taxes
model GfCostEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productName  String
  gfPrice      Float
  regularPrice Float
  store        String?
  purchasedAt  DateTime
  photoUrl     String?
  createdAt    DateTime @default(now())

  @@index([userId, purchasedAt])
}

/// Optional history of label / menu scans — private
model LabelScan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// image | paste | barcode
  source    String
  rawText   String
  barcode   String?
  /// safe | caution | unsafe | unknown
  verdict   String
  reasons   Json
  keep      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// User dismissed a private insight card (keyed, not the copy)
model InsightDismissal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  insightKey String
  createdAt DateTime @default(now())

  @@unique([userId, insightKey])
}

/// Web Push subscription — filled when VAPID keys exist; unused locally without them
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Durable chat fan-out for multi-instance hosts (SSE polls this + in-process hub)
model ChatBusEvent {
  id        String   @id @default(cuid())
  roomId    String
  payload   Json
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserMute {
  id        String   @id @default(cuid())
  muterId   String
  mutedId   String
  muter     User     @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted     User     @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Explicit Top 8 (not “last 8 follows”) — owner picks and orders friends
model TopEightFriend {
  id        String   @id @default(cuid())
  ownerId   String
  friendId  String
  position  Int
  owner     User     @relation("topEightOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friend    User     @relation("topEightFriend", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, friendId])
  @@index([ownerId, position])
}

/// Profile guestbook — plain text only; owner can delete
model ProfileWallComment {
  id            String   @id @default(cuid())
  profileUserId String
  authorId      String
  content       String
  createdAt     DateTime @default(now())
  profileUser   User     @relation("wallOwner", fields: [profileUserId], references: [id], onDelete: Cascade)
  author        User     @relation("wallAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([profileUserId, createdAt])
}

model ScanMissReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanId    String?
  barcode   String?
  rawText   String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
